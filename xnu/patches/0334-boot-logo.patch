diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 7c89470..0618277 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -543,6 +543,10 @@ La5_entry_pixel:
 	mov	x1, #24
 	mov	x2, #256
 	bl	La5_draw_text
+	/* (0334) The boot logo, centered. x0-x14 are free here (the boot args are in x20). */
+	adrp	x0, EXT(hero_bootlogo)@page
+	add	x0, x0, EXT(hero_bootlogo)@pageoff
+	bl	La5_draw_logo
 #endif
 
 #if defined(SWEET) && !defined(A5XELTE)
@@ -1142,6 +1146,43 @@ La5_text_skip_pixel:
 La5_text_done:
 	dsb	sy
 	ret
+/* (0334) Draw the boot logo centered on the physical DECON framebuffer. No stack, MMU off: every access is aligned.
+ * x0: logo data = .long width, .long height, 256 x .long ARGB palette, then width*height palette indexes (bytes).
+ * Index 0 is not drawn (the background stays). Clobbers x0-x14; lr is untouched until ret. */
+	.align 2
+La5_draw_logo:
+	ldr	w1, [x0]
+	ldr	w2, [x0, #4]
+	add	x3, x0, #8
+	add	x4, x3, #1024
+	MOV64	x5, A5XELTE_FB_PA
+	mov	x6, #A5XELTE_FB_WIDTH
+	sub	x6, x6, x1
+	lsr	x6, x6, #1
+	mov	x7, #A5XELTE_FB_HEIGHT
+	sub	x7, x7, x2
+	lsr	x7, x7, #1
+	mov	x8, #A5XELTE_FB_STRIDE
+	madd	x5, x7, x8, x5
+	add	x5, x5, x6, lsl #2
+La5_logo_row:
+	mov	x9, x5
+	mov	x10, x1
+La5_logo_pixel:
+	ldrb	w11, [x4], #1
+	cbz	w11, La5_logo_skip
+	ldr	w12, [x3, x11, lsl #2]
+	str	w12, [x9]
+La5_logo_skip:
+	add	x9, x9, #4
+	subs	x10, x10, #1
+	b.ne	La5_logo_pixel
+	add	x5, x5, x8
+	subs	x2, x2, #1
+	b.ne	La5_logo_row
+	dsb	sy
+	ret
+
 /* (0333) The two lines drawn at the start of the boot. Put any ASCII text between the quotes (8x16 font drawn at 2x,
  * 16 pixels per character, 24 characters fit across), or leave them empty for a clean screen. The colored stage
  * squares are drawn elsewhere and are not affected. */
