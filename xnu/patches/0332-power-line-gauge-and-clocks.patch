diff --git a/bsd/dev/herolte_battery.c b/bsd/dev/herolte_battery.c
index 8ce84d0..8acf21a 100644
--- a/bsd/dev/herolte_battery.c
+++ b/bsd/dev/herolte_battery.c
@@ -217,6 +217,28 @@ herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, uns
 	*ma = (int)(((int64_t)(int16_t)current * 15625) / 100000);
 	*rem_mah = rem / 2u;
 	*full_mah = full / 2u;
+	/* (0332) The last good read and a minute's worth of the current, for the power line in herolte_gpu.c (SweetBattery
+	 * is the only caller, every 30 s; the power thread only reads these and never touches the I2C bus). */
+	extern volatile uint32_t herolte_fg_pct, herolte_fg_mv, herolte_fg_rem_mah, herolte_fg_full_mah, herolte_fg_ma_n;
+	extern volatile int herolte_fg_ma, herolte_fg_ma_min, herolte_fg_ma_max;
+	extern volatile int64_t herolte_fg_ma_sum;
+	extern volatile uint64_t herolte_fg_at;
+	herolte_fg_pct = *percent;
+	herolte_fg_mv = *mv;
+	herolte_fg_rem_mah = *rem_mah;
+	herolte_fg_full_mah = *full_mah;
+	herolte_fg_ma = *ma;
+	herolte_fg_ma_sum += *ma;
+	herolte_fg_ma_n++;
+	if (*ma < herolte_fg_ma_min) {
+		herolte_fg_ma_min = *ma;
+	}
+	if (*ma > herolte_fg_ma_max) {
+		herolte_fg_ma_max = *ma;
+	}
+	uint64_t t_now;
+	clock_get_uptime(&t_now);
+	herolte_fg_at = t_now;
 	return 0;
 }
 #endif /* ARM64_BOARD_CONFIG_HEROLTE */
diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 03ec822..b24feee 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2370,6 +2370,11 @@ hg_cpu_up(void)
  */
 volatile uint64_t herolte_screen_off_at;        /* mach time the display went off; 0 while it is on */
 volatile int herolte_fg_temp_dc = -10000;       /* the battery, tenths of a degree; -10000 not read */
+/* (0332) filled by herolte_fg_read() (herolte_battery.c) every 30 s; printed once a minute by hg_power_thread() */
+volatile uint32_t herolte_fg_pct, herolte_fg_mv, herolte_fg_rem_mah, herolte_fg_full_mah, herolte_fg_ma_n;
+volatile int herolte_fg_ma, herolte_fg_ma_min = 100000, herolte_fg_ma_max = -100000;
+volatile int64_t herolte_fg_ma_sum;
+volatile uint64_t herolte_fg_at;
 
 static const uint32_t hp_tmu_pa[] = { 0x10060000u, 0x10064000u, 0x10068000u, 0x1006c000u };   /* MNGS, APOLLO, GPU, ISP */
 
@@ -2423,6 +2428,8 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 		}
 	}
 	printf("HEROLTE POWER: Mongoose to %u MHz with the screen off or the SoC at %u C (back under %u C)\n", hp_boot_mhz(), hot, cool);
+	/* (0332) read only: the PMU's G3D status and G3D_PLL (CMU_TOP), for the minute line; no Mali register is read here */
+	vm_offset_t pw_pmu = ml_io_map(HG_PMU_PA, 0x8000), pw_top = ml_io_map(0x10570000u, 0x1000);
 	bool hot_now = false;
 	uint64_t last_log = 0;
 	int top = -1000, seen_max = -1000;
@@ -2468,6 +2475,30 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 			printf("HEROLTE POWER: SoC %d C (big %d, little %d, GPU %d, ISP %d; most %d), battery reg %d.%u C, Mongoose %s, screen %s\n",
 			    top, c[0], c[1], c[2], c[3], seen_max, b / 10, (unsigned)(b < 0 ? -b : b) % 10, hc.high ? "up" : "down", off ? "off" : "on");
 			seen_max = -1000;
+			/* (0332) Where the power goes: the gauge (30 s reads) and the clocks that stay up with the screen off. */
+			if (herolte_fg_at != 0) {
+				uint64_t age = 0;
+				if (now > herolte_fg_at) {
+					absolutetime_to_nanoseconds(now - herolte_fg_at, &age);
+				}
+				uint32_t n = herolte_fg_ma_n;
+				int64_t sum = herolte_fg_ma_sum;
+				int mn = herolte_fg_ma_min, mx = herolte_fg_ma_max;
+				herolte_fg_ma_n = 0;
+				herolte_fg_ma_sum = 0;
+				herolte_fg_ma_min = 100000;
+				herolte_fg_ma_max = -100000;
+				printf("HEROLTE POWER: battery %u%% %u mV, %u of %u mAh, %d mA now (%u reads this minute: avg %d, min %d, max %d; positive = charging), last read %llu s ago\n",
+				    herolte_fg_pct, herolte_fg_mv, herolte_fg_rem_mah, herolte_fg_full_mah, herolte_fg_ma, n,
+				    n ? (int)(sum / (int64_t)n) : 0, n ? mn : 0, n ? mx : 0, age / NSEC_PER_SEC);
+			}
+			if (pw_pmu && pw_top) {
+				uint32_t pstat = hg_rd(pw_pmu, HG_PMU_G3D_STAT), pcon = hg_rd(pw_top, 0x1e0);
+				uint32_t pm = (pcon >> 16) & 0x3ff, pp = (pcon >> 8) & 0x3f, ps = pcon & 7;
+				printf("HEROLTE POWER: GPU domain %s (status %#x), G3D_PLL %s at %u MHz; Mongoose at %u MHz; screen %s\n",
+				    (pstat & 0xf) == 0xf ? "on" : "off", pstat, (pcon >> 31) ? "on" : "off", pp ? 26 * pm / (pp << ps) : 0u,
+				    hc.high ? hc.mhz : hp_boot_mhz(), off ? "off" : "on");
+			}
 		}
 	}
 }
